Response=7E8 03 7F 3E 12
Interpretation=Negative response - Sub-function not supported
Status=MODULE_RESPONDS

# Extended Diagnostic Session
Command=10 03
Response=Not tested
Notes=May require security access (0x27)

# Read DTCs
Command=19 02 FF
Response=7F 19
Interpretation=Negative response - Requires extended session
Status=REQUIRES_EXTENDED_SESSION

# DID Scanning (default session)
DIDs_Tested=F100-F1FF, F200-F2FF, 0100-01FF
DIDs_Found=0
Notes=No DIDs accessible in default diagnostic session
