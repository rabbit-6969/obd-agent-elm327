Notes=VIN reading corrupted, non-printable characters present
ExpectedFormat=1J8 + 14 characters
ActualLength=11 characters (incomplete)
Recommendation=Read VIN from dashboard plate or door jamb

[PCM_COMMUNICATION]
Address=0x7E0
ResponseAddress=0x7E8
Protocol=ISO 15765-4 CAN (11 bit, 500 kbaud)

# Tester Present
