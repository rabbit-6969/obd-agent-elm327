[CAN_BUS_MONITORING]
Method=ATMA (Monitor All)
Status=BLOCKED
Issue=ELM327 ATMA header bug

# ATMA Test
Command=ATH1
Response=OK
Notes=Command accepted but headers not included in ATMA output

Command=ATMA
Duration=30 seconds
LinesReceived=0
CANIDsCaptured=0
Status=FAILED
Issue=Adapter has ATMA header bug - no CAN IDs in output

# ATCRA Workaround
Method=ATCRA (CAN Receive Address filtering)
Status=NOT_ATTEMPTED
Reason=Requires knowing target CAN IDs (unknown without working ATMA)
Notes=Catch-22 - cannot discover CAN IDs without working ATMA

# Known Jeep CAN IDs (from other models, not confirmed)
PossibleGearPositionIDs=0x1F5, 0x2C1, 0x308
PossibleGasPedalIDs=Unknown
Status=UNCONFIRMED

Recommendation=Use quality adapter (Vgate, OBDLink) or AlfaOBD

[ADAPTER_LIMITATIONS]
Adapter=ELM327 v1.5 clone
ATMAHeaderBug=YES
Impact=Cannot monitor CAN bus to discover gear/pedal signals

Symptoms:
- ATH1 returns OK
- ATMA receives data
- No CAN IDs in output
- Lines are continuous hex without spaces
- Parser cannot extract CAN IDs

Workarounds:
1. Use ATCRA filtering (requires known CAN IDs)
2. Upgrade to quality adapter
3. Use AlfaOBD instead

Reference=reference/ELM327_ATMA_Header_Bug.md

